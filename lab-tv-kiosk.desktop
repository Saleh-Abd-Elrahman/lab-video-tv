[Desktop Entry]
# Kiosk: HDMI stick / mini-PC drives the panel, Samsung plays dumb monitor.
# Copy to ~/.config/autostart/lab-tv-kiosk.desktop on any Debian/Raspberry Pi OS
# desktop session.
#
# Everything that used to be crammed onto this line — the crash recovery loop,
# the wait for the audio server, the Chromium flags — now lives in
# lab-tv-kiosk.sh next to it, along with the 08:00-22:00 Madrid schedule and the
# CEC calls that put the panel to sleep overnight. Edit the hours there.
Type=Application
Name=Lab TV
# Through a shell so $HOME expands: Desktop Entry files don't do ~ themselves,
# and the account on this box isn't necessarily called pi.
Exec=bash -c 'exec "$HOME/lab-tv/lab-tv-kiosk.sh"'
X-GNOME-Autostart-enabled=true
